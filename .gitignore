.venv/
__pycache__/
*.pyc
.pytest_cache/

# Working output of `python run_demo.py`. The graded run of record is committed
# separately under submission_artifacts/ once it is captured -- see README.
/work/

# Checkpoint weight blobs: ~15 MB each of float32 (model + Adam m + v), 139 MB for the
# run of record. They are regenerated by `python run_demo.py`, and nothing needed to
# *verify* the run lives in them -- each checkpoint's .meta.json carries its model hash,
# state sha256, bound ledger offset and fork lineage, and those are committed. The audit
# and the tests read the metadata and the index, never the weights.
submission_artifacts/checkpoints/*.npz
